From a3dbd624e7c6518cfb3862f720cc1c9f02d15e6e Mon Sep 17 00:00:00 2001
From: sammyz <2353166+sammyz@users.noreply.github.com>
Date: Mon, 26 Oct 2026 13:11:19 +0000
Subject: [PATCH 1/3] vold: import recovery key-blob and fscrypt keyring fixes

Restore the no-upgrade early return before accessing the optional upgraded
key blob. Create the fscrypt session keyring when recovery has no ring yet.
Metadata and existing device-encrypted keys were loaded on Motorola mona
without removing its logical System mapping.

Imported from the user's earlier Antigravity session. Codex was used to
review, test, organize, and commit these changes at sammyz's direction.
Original upstream authorship and licenses remain intact.

Change-Id: Id3dddd0fd97a264536b4f058c88f76a842c98579
---
 KeyStorage.cpp | 2 +-
 KeyUtil.cpp    | 3 +++
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/KeyStorage.cpp b/KeyStorage.cpp
index 51fc4f6..a6b81a3 100644
--- a/KeyStorage.cpp
+++ b/KeyStorage.cpp
@@ -370,7 +370,7 @@ static KeymasterOperation BeginKeymasterOp(Keymaster& keymaster, const std::stri
     if (!opHandle) return opHandle;
 
     // If key blob wasn't upgraded, nothing left to do.
-    // if (!opHandle.getUpgradedBlob()) return opHandle;
+    if (!opHandle.getUpgradedBlob()) return opHandle;
 
     // if (already_upgraded) {
     //     LOG(ERROR) << "Unexpected case; already-upgraded key " << upgraded_blob_file
diff --git a/KeyUtil.cpp b/KeyUtil.cpp
index 9273564..3f1740d 100644
--- a/KeyUtil.cpp
+++ b/KeyUtil.cpp
@@ -148,6 +148,9 @@ static std::string buildLegacyKeyName(const std::string& prefix, const std::stri
 // old to support FS_IOC_ADD_ENCRYPTION_KEY and FS_IOC_REMOVE_ENCRYPTION_KEY.
 static bool fscryptKeyring(key_serial_t* device_keyring) {
     *device_keyring = keyctl_search(KEY_SPEC_SESSION_KEYRING, "keyring", "fscrypt", 0);
+    if (*device_keyring == -1) {
+        *device_keyring = add_key("keyring", "fscrypt", 0, 0, KEY_SPEC_SESSION_KEYRING);
+    }
     if (*device_keyring == -1) {
         PLOG(ERROR) << "Unable to find device keyring";
         return false;
