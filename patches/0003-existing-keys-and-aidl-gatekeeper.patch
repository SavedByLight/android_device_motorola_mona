From b5d90bc60c78148d9ba943e4f3a11563b7a48180 Mon Sep 17 00:00:00 2001
From: sammyz <2353166+sammyz@users.noreply.github.com>
Date: Mon, 26 Oct 2026 13:11:19 +0000
Subject: [PATCH 2/3] vold: load existing recovery DE keys without Android boot
 provisioning

Under ro.mona.recovery.readonly_keys, require existing system/user-0 keys,
install them, and skip boot-time option/reference/per-boot-key writes and
user-directory provisioning. The normal Android path is unchanged.

Verified file reads from /data/system/packages.xml alongside
/system_root/system/build.prop in normal TWRP startup. Credential-encrypted
user storage remains a separate, unverified unlock step.

Codex was used to make all changes in this commit at sammyz's direction.

Change-Id: I351fa8fcd2fd1bf351a9e61b39edf76a0eab9ebb
---
 FsCrypt.cpp | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/FsCrypt.cpp b/FsCrypt.cpp
index 7505e56..ddcbc48 100644
--- a/FsCrypt.cpp
+++ b/FsCrypt.cpp
@@ -455,6 +455,11 @@ bool fscrypt_initialize_systemwide_keys() {
     EncryptionOptions options;
     if (!get_data_file_encryption_options(&options)) return false;
 
+    if (android::base::GetBoolProperty("ro.mona.recovery.readonly_keys", false) &&
+        !android::vold::pathExists(device_key_path)) {
+        LOG(ERROR) << "Recovery: existing systemwide key is missing; refusing generation";
+        return false;
+    }
     KeyBuffer device_key;
 install:
     if (!retrieveOrGenerateKey(device_key_path, device_key_temp, kEmptyAuthentication,
@@ -473,6 +478,11 @@ install:
         return false;
     }
 
+    if (android::base::GetBoolProperty("ro.mona.recovery.readonly_keys", false)) {
+        de_key_raw_ref = device_policy.key_raw_ref;
+        LOG(INFO) << "Recovery: installed existing system DE key; skipping boot-time key writes";
+        return true;
+    }
     std::string options_string;
     if (!OptionsToString(device_policy.options, &options_string)) {
         LOG(ERROR) << "Unable to serialize options";
@@ -500,6 +510,14 @@ install:
 
 bool fscrypt_init_user0() {
     LOG(INFO) << "fscrypt_init_user0";
+    if (android::base::GetBoolProperty("ro.mona.recovery.readonly_keys", false)) {
+        if (!android::vold::pathExists(get_de_key_path(0))) {
+            LOG(ERROR) << "Recovery: existing user-0 DE key missing; refusing generation";
+            return false;
+        }
+        LOG(INFO) << "Recovery: loading existing DE keys without provisioning user directories";
+        return load_all_de_keys();
+    }
     if (fscrypt_is_native()) {
         if (!prepare_dir(user_key_dir, 0700, AID_ROOT, AID_ROOT)) return false;
         if (!prepare_dir(user_key_dir + "/ce", 0700, AID_ROOT, AID_ROOT)) return false;
