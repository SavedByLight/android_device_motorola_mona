 // /* Decrypt_User_Synth_Pass is the TWRP C++ equivalent to spBasedDoVerifyCredential
 //  * https://android.googlesource.com/platform/frameworks/base/+/android-8.0.0_r23/services/core/java/com/android/server/locksettings/LockSettingsService.java#1998 */
+// Codex: verify existing credentials through the stock AIDL HAL. Never enroll,
+// delete credentials, log secrets, or retry a rejected credential via another HAL.
+static bool VerifyMonaAidlGatekeeper(userid_t user_id,
+                                     const password_data_struct& pwd,
+                                     const unsigned char* password_token) {
+    using AidlGatekeeper = aidl::android::hardware::gatekeeper::IGatekeeper;
+    ndk::SpAIBinder binder(AServiceManager_checkService(
+        "android.hardware.gatekeeper.IGatekeeper/default"));
+    auto gatekeeper = AidlGatekeeper::fromBinder(binder);
+    if (!gatekeeper || pwd.handle_len <= 0 || !pwd.password_handle) {
+        printf("AIDL Gatekeeper service or existing credential handle unavailable\n");
+        return false;
+    }
+    void* derived = PersonalizedHashBinary(PERSONALIZATION_USER_GK_AUTH,
+        reinterpret_cast<const char*>(password_token), PASSWORD_TOKEN_SIZE);
+    if (!derived) return false;
+    const auto* bytes = static_cast<const uint8_t*>(derived);
+    std::vector<uint8_t> provided(bytes, bytes + SHA512_DIGEST_LENGTH);
+    const auto* handle_bytes = static_cast<const uint8_t*>(pwd.password_handle);
+    std::vector<uint8_t> enrolled(handle_bytes, handle_bytes + pwd.handle_len);
+    aidl::android::hardware::gatekeeper::GatekeeperVerifyResponse response;
+    auto status = gatekeeper->verify(fakeUid(user_id), 0, enrolled, provided, &response);
+    OPENSSL_cleanse(provided.data(), provided.size());
+    OPENSSL_cleanse(derived, SHA512_DIGEST_LENGTH);
+    free(derived);
+    if (!status.isOk()) {
+        printf("AIDL Gatekeeper transaction failed: %s\n", status.getDescription().c_str());
+        return false;
+    }
+    if (response.statusCode != AidlGatekeeper::STATUS_OK &&
+        response.statusCode != AidlGatekeeper::STATUS_REENROLL) {
+        printf("AIDL Gatekeeper verification failed: status=%d timeout_ms=%d\n",
+               response.statusCode, response.timeoutMs);
+        return false;
+    }
+    ndk::SpAIBinder auth_binder(AServiceManager_checkService("android.security.authorization"));
+    auto authorization = aidl::android::security::authorization::IKeystoreAuthorization::fromBinder(auth_binder);
+    if (!authorization) {
+        printf("AIDL Gatekeeper verified; Keystore authorization unavailable\n");
+        return false;
+    }
+    auto auth_status = authorization->addAuthToken(response.hardwareAuthToken);
+    if (!auth_status.isOk()) {
+        printf("AIDL Gatekeeper verified; auth token submission failed: %s\n",
+               auth_status.getDescription().c_str());
+        return false;
+    }
+    printf("AIDL Gatekeeper verified existing credential and submitted auth token\n");
+    return true;
+}
+
 bool Decrypt_User_Synth_Pass(const userid_t user_id, const std::string& Password) {
 	printf("Attempting to decrypt user's synthetic password\n");
 	bool retval = false;
@@ -749,6 +803,11 @@ bool Decrypt_User_Synth_Pass(const userid_t user_id, const std::string& Password
 		memcpy((void*)&application_id[0], (void*)&password_token[0], PASSWORD_TOKEN_SIZE);
 		memcpy((void*)&application_id[PASSWORD_TOKEN_SIZE], secdiscardable, SHA512_DIGEST_LENGTH);
 		if (Password != "!") {
+            if (android::base::GetBoolProperty("ro.mona.gatekeeper_aidl", false)) {
+                if (!VerifyMonaAidlGatekeeper(user_id, pwd, password_token))
+                    return Free_Return(retval, weaver_key, &pwd);
