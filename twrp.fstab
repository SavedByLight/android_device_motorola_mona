# TWRP fstab: mount point, filesystem, block device, flags.
/external_sd auto /dev/block/mmcblk1p1 /dev/block/mmcblk0p1 flags=display=MicroSD;storage;settingsstorage;wipeingui;removable
/system_root ext4 system flags=fsflags=ro,noload;logical;slotselect;display=System;backup=1
/system_ext ext4 system_ext flags=fsflags=ro,noload;logical;slotselect;display=System_Ext;backup=1
/product ext4 product flags=fsflags=ro,noload;logical;slotselect;display=Product;backup=1
/vendor erofs vendor flags=fsflags=ro;logical;slotselect;display=Vendor;backup=1
/vendor_dlkm erofs vendor_dlkm flags=fsflags=ro;logical;slotselect;display=Vendor_DLKM;backup=1
/system_dlkm erofs system_dlkm flags=fsflags=ro;logical;slotselect;display=System_DLKM;backup=1
/metadata f2fs /dev/block/bootdevice/by-name/metadata flags=display=Metadata;backup=1
/data f2fs /dev/block/bootdevice/by-name/userdata flags=display=Data;backup=1;fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0;metadata_encryption=aes-256-xts:wrappedkey_v0;keydirectory=/metadata/vold/metadata_encryption
/boot emmc /dev/block/bootdevice/by-name/boot flags=slotselect;display=Boot;backup=1;flashimg=1
/init_boot emmc /dev/block/bootdevice/by-name/init_boot flags=slotselect;display=Init_Boot;backup=1;flashimg=1
/vendor_boot emmc /dev/block/bootdevice/by-name/vendor_boot flags=slotselect;display=Vendor_Boot;backup=1;flashimg=1
/recovery emmc /dev/block/bootdevice/by-name/recovery flags=slotselect;display=Recovery;backup=1;flashimg=1
/dtbo emmc /dev/block/bootdevice/by-name/dtbo flags=slotselect;display=DTBO;backup=1;flashimg=1
/misc emmc /dev/block/bootdevice/by-name/misc
/usb_otg auto /dev/block/sda1 flags=display=USB_OTG;storage;wipeingui;removable
